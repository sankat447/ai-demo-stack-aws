# =============================================================================
#  AI Demo Stack on AWS — Git Ignore
#  Excludes all generated, secret, and ephemeral files from version control
# =============================================================================

# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform vars contain secrets (pull_secret, passwords, SSH keys)
*.tfvars
!*.tfvars.example

# ── OCP IPI Install Artifacts ────────────────────────────────────────────────
# Contains kubeconfig, kubeadmin-password, metadata.json, terraform.tfstate
# These are generated by openshift-install and contain sensitive cluster creds
**/ocp-install-dir/
.openshift_install.log
.openshift_install_state.json

# ── Generated MachineSets / Autoscalers ──────────────────────────────────────
**/generated/

# ── Lambda Build Artifacts ───────────────────────────────────────────────────
**/scheduler.zip
*.zip

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Secrets & Credentials ────────────────────────────────────────────────────
.pull-secret.json
pull-secret.json
pull-secret.txt
*.pem
*.key
*.crt
*.p12
*.jks
kubeconfig
kubeadmin-password
auth/

# ── Infrastructure IDs (extracted post-install) ──────────────────────────────
oidc-issuer-url
infrastructure-id

# ── OS / Editor / IDE ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/
.ocp-installer-creds.json
